PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection: Leave blank for zero-setup In-Memory DB, or add MongoDB Atlas URI:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/marketplace?retryWrites=true&w=majority
MONGO_URI=

# Redis: Leave blank for zero-cost In-Memory Redis Mock, or add Upstash / local Redis:
# REDIS_URL=redis://default:<password>@<endpoint>:6379
REDIS_URL=

# Elasticsearch: Leave blank for built-in Zero-Cost Search Engine, or add Bonsai / Elastic Cloud URL:
# ELASTICSEARCH_URL=https://<user>:<pass>@my-cluster.bonsaisearch.net
ELASTICSEARCH_URL=

# JWT Secrets (Use a 256-bit secure secret in production)
JWT_SECRET=zero_cost_jwt_dev_secret_2026_super_secure_key
JWT_EXPIRES_IN=7d

# Payment Gateways (Stripe Connect / Razorpay Route)
STRIPE_SECRET_KEY=sk_test_mock_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_mock_stripe_webhook
RAZORPAY_KEY_ID=rzp_test_mock_key
RAZORPAY_KEY_SECRET=mock_razorpay_secret

# Cloud Media Storage (Optional: AWS S3 or Cloudinary)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET_NAME=
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
